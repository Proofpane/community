{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://proofpane.com/schema/verification-manifest-0.schema.json",
 "title": "Proofpane Verification Manifest v0",
 "description": "The shape of a manifest. Cross-field rules are enforced by the reference validator (proofpane_core.manifest.validate) and listed in $comment; the decision must equal what the gate derives from the obligations (proofpane_core.manifest.rederive). Canonical form and digest: RFC 8785, sha256.",
 "$comment": "Rules this schema does not express: obligation ids are unique; an implicit obligation has a resolver and no claim; a claim with no resolver has method 'none' and outcome 'unverified'; a resolved obligation has method 'deterministic'; a proposed claim is advisory; 'unverified' and 'error' need a non-empty reason; deny_type appears only on a failed obligation; a base-ref or supplied policy has a path and the default policy has none; decision.deny_type is set exactly when decision.verify is 'failure'; issued_at is a real calendar time. Validity is judged on the value re-parsed from the RFC 8785 canonical form, so an integer written as an integral float (42.0) is the same integer. Before any of this, the file must read under RFC 8785 as proofpane_core.canonical.loads_strict reads it, which this schema cannot say: no duplicate keys, NaN or Infinity; nesting at most 64 levels of brackets; no lone surrogates; and an integer literal beyond 2**53 - 1 only when it is the RFC 8785 spelling of a double, in which case it is that double, so it is not an integer here. A manifest the schema accepts with, say, an evidence integer of 2**53 + 1 is refused as not-canonical. The patterns are ECMA-262 and match the whole string; a validator built on Python's re must apply them with fullmatch, since its $ also matches before a trailing newline.",
 "type": "object",
 "additionalProperties": false,
 "required": ["format", "subject", "verifier", "policy", "obligations", "unrecognised_sentences", "decision", "issued_at"],
 "properties": {
  "format": {"const": "proofpane.verification-manifest/0"},
  "subject": {
   "type": "object",
   "additionalProperties": false,
   "required": ["kind", "repo", "base_sha", "head_sha", "diff_digest", "claims_digest"],
   "properties": {
    "kind": {"const": "git-change"},
    "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "base_sha": {"$ref": "#/$defs/sha"},
    "head_sha": {"$ref": "#/$defs/sha"},
    "diff_digest": {"$ref": "#/$defs/digest"},
    "claims_digest": {"$ref": "#/$defs/digest"}
   }
  },
  "verifier": {
   "type": "object",
   "additionalProperties": false,
   "required": ["name", "version", "ruleset_fingerprint"],
   "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "ruleset_fingerprint": {"$ref": "#/$defs/digest"}
   }
  },
  "policy": {
   "type": "object",
   "additionalProperties": false,
   "required": ["source", "path", "digest"],
   "properties": {
    "source": {"enum": ["base-ref", "supplied", "default"]},
    "path": {"type": ["string", "null"]},
    "digest": {"$ref": "#/$defs/digest"}
   }
  },
  "obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligation"}},
  "unrecognised_sentences": {"type": "integer", "minimum": 0},
  "decision": {
   "type": "object",
   "additionalProperties": false,
   "required": ["verify", "claims", "rule_id", "deny_type", "because"],
   "properties": {
    "verify": {"enum": ["success", "failure"]},
    "claims": {"enum": ["success", "failure"]},
    "rule_id": {"enum": ["nothing-blocking", "any-fail", "needs-person", "advisory-not-vouched", "all-pass"]},
    "deny_type": {"enum": ["correctable", "terminal", null]},
    "because": {"type": "array", "items": {"type": "string"}}
   }
  },
  "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
 },
 "$defs": {
  "sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
  "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
  "evidence_value": {"oneOf": [{"type": "string", "maxLength": 1024}, {"type": "integer"}, {"type": "boolean"}, {"type": "null"}]},
  "obligation": {
   "type": "object",
   "additionalProperties": false,
   "required": ["id", "origin", "claim", "resolver", "class", "method", "outcome", "reason", "evidence"],
   "properties": {
    "id": {"type": "string", "pattern": "^V-[0-9]{3,}$"},
    "origin": {"enum": ["claimed", "implicit", "proposed"]},
    "claim": {
     "oneOf": [
      {"type": "null"},
      {
       "type": "object",
       "additionalProperties": false,
       "required": ["text", "location"],
       "properties": {
        "text": {"type": "string", "minLength": 1},
        "location": {"enum": ["pr_title", "pr_body"]},
        "pattern": {"type": "string"}
       }
      }
     ]
    },
    "resolver": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
    "class": {"enum": ["security", "required", "advisory"]},
    "method": {"enum": ["deterministic", "none"]},
    "outcome": {"enum": ["pass", "fail", "unverified", "error"]},
    "reason": {"type": ["string", "null"]},
    "evidence": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
       "kind": {"type": "string", "minLength": 1, "maxLength": 1024},
       "ref": {"$ref": "#/$defs/evidence_value"},
       "name": {"$ref": "#/$defs/evidence_value"},
       "app": {"$ref": "#/$defs/evidence_value"},
       "conclusion": {"$ref": "#/$defs/evidence_value"},
       "context": {"$ref": "#/$defs/evidence_value"},
       "state": {"$ref": "#/$defs/evidence_value"},
       "rule": {"$ref": "#/$defs/evidence_value"},
       "fingerprint": {"$ref": "#/$defs/evidence_value"},
       "note": {"$ref": "#/$defs/evidence_value"},
       "added_lines": {"$ref": "#/$defs/evidence_value"},
       "line": {"$ref": "#/$defs/evidence_value"},
       "digest": {"$ref": "#/$defs/evidence_value"}
      }
     }
    },
    "deny_type": {"enum": ["correctable", "terminal"]}
   }
  }
 }
}
